{
  "name": "uniclipboard",
  "private": true,
  "version": "1.1.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "version:bump": "node scripts/bump-version.js",
    "add:beui": "bun run --cwd apps/gui add:beui",
    "gen:openapi": "cargo run -p uc-webserver --bin gen-openapi",
    "gen:client": "bun run --cwd apps/gui gen:client",
    "gen:api": "bun run gen:openapi && bun run gen:client",
    "mbx:exec": "bash scripts/build-cache/mbx.sh --exec",
    "wails:dev": "cross-env UNICLIPBOARD_ENV=development UC_PROFILE=dev node scripts/wails-dev.mjs",
    "wails:dev:profile": "node scripts/wails-dev.mjs --profile",
    "test": "bun run --cwd apps/gui test",
    "test:coverage:frontend": "bun run --cwd apps/gui test:coverage:frontend",
    "typecheck": "bun run --cwd apps/gui typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "test:coverage": "cargo llvm-cov --html --workspace",
    "check:engine-repository": "node scripts/architecture/check-engine-repository.mjs",
    "check:tauri-retired": "node scripts/architecture/check-tauri-retired.mjs",
    "check:cargo-audit-exceptions": "node scripts/architecture/check-cargo-audit-exceptions.mjs",
    "e2e:custom-relays": "node apps/gui/e2e/custom-relays.e2e.mjs",
    "e2e:relay-overview": "node apps/gui/e2e/relay-overview.e2e.mjs",
    "doctor": "bun run --cwd apps/gui doctor"
  },
  "lint-staged": {
    "Cargo.toml": [
      "node scripts/refresh-agents-structure.mjs"
    ],
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.md": [
      "node scripts/fix-md-cjk-emphasis.mjs",
      "autocorrect --fix"
    ],
    "*.{json,css,html}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "{apps,crates}/**/*.rs": [
      "rustfmt --edition 2021"
    ]
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@react-grab/mcp": "^0.1.37",
    "@sentry/vite-plugin": "^5.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.7.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "autocorrect-node": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "postcss": "^8.5.29",
    "react-grab": "^0.2.0",
    "shadcn": "^4.21.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "webdriverio": "^10.0.0"
  },
  "workspaces": [
    "apps/gui",
    "apps/gui-go"
  ]
}
